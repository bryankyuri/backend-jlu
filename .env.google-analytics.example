# Add this to your Laravel .env file

# Google Analytics Configuration
GOOGLE_ANALYTICS_VIEW_ID=123456789
GOOGLE_ANALYTICS_PROJECT_ID=your-project-id
GOOGLE_SERVICE_ACCOUNT_PATH=C:\path\to\your\service-account-key.json

# Alternative: Environment Variables (if not using JSON file)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=your_client_id_here
# GOOGLE_SERVICE_ACCOUNT_KEY_ID=your_private_key_id_here
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"